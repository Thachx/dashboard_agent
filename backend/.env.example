AWS_REGION=ap-southeast-1
S3_DATA_URI=s3://edx-nectec-demo
GRAPH_PATH=./data/s3-json-graph.json
GRAPHIFY_OUTPUT_DIR=./data/graphify-out
GRAPHIFY_BIN=graphify
GRAPHIFY_ENABLED=true
GRAPH_REFRESH_SECONDS=300
GRAPH_MAX_OBJECT_BYTES=10485760
S3_INCLUDE_EXTENSIONS=.json,.parquet

# Optional LLM synthesis. Without these values the agent returns graph-grounded summaries.
# auto = use LLM only when graph context is found; always = use whenever a model is configured; never = disable LLM.
LLM_MODE=auto
# auto = try OpenRouter then OpenAI; openrouter = OpenRouter only; openai = OpenAI-compatible only.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAIN_MODEL=openai/gpt-4.1-mini
OPENROUTER_RESERVE_MODEL_1=
OPENROUTER_RESERVE_MODEL_2=
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Dashboard Graph Agent

# Optional direct OpenAI-compatible fallback after OpenRouter models fail.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
