AWS_REGION=ap-southeast-1
S3_DATA_URI=s3://edx-nectec-demo/data
GRAPH_PATH=./data/s3-json-graph.json
GRAPH_REFRESH_SECONDS=300
GRAPH_MAX_OBJECT_BYTES=10485760

# Optional LLM synthesis. Without these values the agent returns graph-grounded summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Power BI app-owns-data embed settings. POWER_BI_EMBED_URL alone also supports
# publish-to-web or organization embed URLs.
POWER_BI_EMBED_URL=
POWER_BI_REPORT_ID=
POWER_BI_ACCESS_TOKEN=
